#!/bin/sh
# The SSH Host torvus entry supplies the address and identity.
set -eu

usage() {
  printf '%s\n' \
    'Usage: torvus [--ssh | --safe | --help]' \
    '  torvus         Mosh with immediate local typing prediction.' \
    '  torvus --ssh   SSH with local shell-line editing (requires uv).' \
    '  torvus --safe  Ordinary SSH for hidden passwords and tokens.'
}

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

case ${1-} in
  '')
    printf '%s\n' 'Local echo enabled; use torvus --safe for hidden passwords.' >&2
    exec mosh --predict=experimental torvus
    ;;
  --safe) exec ssh torvus ;;
  --ssh)
    if ! command -v uv >/dev/null 2>&1; then
      printf '%s\n' 'Install uv for local editing: https://docs.astral.sh/uv/getting-started/installation/' >&2
      exit 127
    fi
    exec uv run --script "$(dirname "$0")/torvus-ssh.py"
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
